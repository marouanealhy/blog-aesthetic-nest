---
interface Props {
  title: string;
  brand?: string;
  price: string;
  rating?: string;
  reviews?: string;
  imageUrl: string;
  altText?: string;
  affiliateUrl: string;
  badge?: string;
  prime?: boolean;
  description?: string;
}

const {
  title,
  brand,
  price,
  rating = "4.8",
  reviews = "940+",
  imageUrl,
  altText = title,
  affiliateUrl,
  badge,
  prime = true,
  description
} = Astro.props;
---

<div class="product-callout-card">
  {badge && <span class="card-badge">{badge}</span>}
  
  <div class="card-image-wrap">
    <img src={imageUrl} alt={altText} loading="lazy" />
  </div>

  <div class="card-body">
    {brand && <span class="product-brand">{brand}</span>}
    <h4 class="product-title">{title}</h4>
    
    <div class="product-meta">
      <div class="rating-stars">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#D97706">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span class="rating-score">{rating}</span>
        <span class="reviews-count">({reviews})</span>
      </div>

      <div class="price-wrap">
        <span class="product-price">{price}</span>
        {prime && (
          <span class="prime-tag" title="Available with Amazon Prime Free Delivery">
            <span class="prime-bold">prime</span>
          </span>
        )}
      </div>
    </div>

    {description && <p class="product-blurb">{description}</p>}

    <div class="card-action">
      <a 
        href={affiliateUrl} 
        target="_blank" 
        rel="sponsored nofollow noopener noreferrer" 
        class="btn-amazon"
      >
        <span>Shop on Amazon</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
      <span class="sponsored-label">Amazon Affiliate Link</span>
    </div>
  </div>
</div>

<style>
  .product-callout-card {
    position: relative;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.75rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin: 2.5rem 0;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .product-callout-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent-sand);
  }

  .card-badge {
    position: absolute;
    top: -10px;
    left: 1.5rem;
    background-color: var(--color-accent-terracotta);
    color: #ffffff;
    font-size: 0.675rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    box-shadow: 0 2px 6px rgba(185, 102, 70, 0.35);
  }

  .card-image-wrap {
    width: 100%;
    height: 100%;
    min-height: 180px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--color-surface-subtle);
  }

  .card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-smooth);
  }

  .product-callout-card:hover .card-image-wrap img {
    transform: scale(1.04);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .product-brand {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .product-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text-primary);
    margin-bottom: 0.65rem;
  }

  .product-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .rating-stars {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
  }

  .rating-score {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .reviews-count {
    color: var(--color-text-muted);
  }

  .price-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .product-price {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .prime-tag {
    background-color: #00A8E1;
    color: #ffffff;
    font-size: 0.7rem;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    font-weight: 800;
    font-style: italic;
    letter-spacing: -0.02em;
  }

  .product-blurb {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .card-action {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
  }

  .sponsored-label {
    font-size: 0.725rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 650px) {
    .product-callout-card {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .card-image-wrap {
      height: 220px;
    }

    .card-action {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
