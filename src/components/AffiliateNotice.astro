---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class={`affiliate-notice-container ${compact ? 'compact' : ''}`}>
  <div class="notice-icon">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="16" x2="12" y2="12"></line>
      <line x1="12" y1="8" x2="12.01" y2="8"></line>
    </svg>
  </div>
  <div class="notice-text">
    <p>
      <strong>Reader Disclosure:</strong> Aesthetic Nest is reader-supported. As an Amazon Associate, we earn from qualifying purchases made through our curated links at no additional cost to you. All recommendations are independently styled. <a href="/disclosure" class="learn-more">Learn more about our affiliate policy</a>.
    </p>
  </div>
</div>

<style>
  .affiliate-notice-container {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem 1.25rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent-sand);
    border-radius: var(--radius-sm);
    margin: 1.75rem 0 2.5rem;
    font-size: 0.825rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .affiliate-notice-container.compact {
    padding: 0.75rem 1rem;
    margin: 1rem 0 1.5rem;
  }

  .notice-icon {
    flex-shrink: 0;
    color: var(--color-accent-terracotta);
    margin-top: 1px;
  }

  .notice-text p {
    font-size: 0.825rem;
    line-height: 1.55;
    margin-bottom: 0;
    color: var(--color-text-secondary);
  }

  .notice-text strong {
    color: var(--color-text-primary);
  }

  .learn-more {
    color: var(--color-accent-terracotta);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .learn-more:hover {
    color: var(--color-accent-terracotta-dark);
  }
</style>
