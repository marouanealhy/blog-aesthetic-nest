---
import PinterestButton from './PinterestButton.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  categoryLabel: string;
  heroImage: string;
  heroAlt: string;
  pinterestImage: string;
  readTime: string;
  featured?: boolean;
}

const {
  slug,
  title,
  description,
  pubDate,
  category,
  categoryLabel,
  heroImage,
  heroAlt,
  pinterestImage,
  readTime,
  featured = false,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(pubDate);

const postUrl = `/blog/${slug}`;
---

<article class={`post-card ${featured ? 'featured' : ''}`}>
  <!-- Pinterest Optimized Visual Frame (2:3 aspect ratio) -->
  <div class="card-media-wrapper pinterest-frame">
    <a href={postUrl} class="media-link" aria-label={`Read ${title}`}>
      <img 
        src={pinterestImage || heroImage} 
        alt={heroAlt || title} 
        loading="lazy" 
        width="1000" 
        height="1500"
      />
    </a>

    <!-- Overlay "Save to Pinterest" button -->
    <div class="pin-overlay-wrapper">
      <PinterestButton 
        url={`https://aestheticnest.com${postUrl}`}
        media={pinterestImage || heroImage}
        description={`${title} - Interior design ideas on Aesthetic Nest`}
        variant="overlay"
        label="Pin"
      />
    </div>

    <!-- Category Tag -->
    <a href={`/categories/${category}`} class="card-category-tag">
      {categoryLabel}
    </a>
  </div>

  <!-- Editorial Card Content -->
  <div class="card-content">
    <div class="card-meta">
      <span class="meta-date">{formattedDate}</span>
      <span class="meta-dot">•</span>
      <span class="meta-read-time">{readTime}</span>
    </div>

    <h3 class="card-title">
      <a href={postUrl}>{title}</a>
    </h3>

    <p class="card-description">{description}</p>

    <div class="card-footer">
      <a href={postUrl} class="read-more-link">
        <span>Read Story</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-accent-sand);
  }

  .card-media-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3; /* 1000 x 1500 vertical Pinterest standard */
    background-color: var(--color-surface-subtle);
    overflow: hidden;
  }

  .media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card-media-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-smooth);
  }

  .post-card:hover .card-media-wrapper img {
    transform: scale(1.04);
  }

  .pin-overlay-wrapper {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 10;
    opacity: 0;
    transform: translateY(-4px);
    transition: all var(--transition-fast);
  }

  .post-card:hover .pin-overlay-wrapper {
    opacity: 1;
    transform: translateY(0);
  }

  .card-category-tag {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background-color: rgba(250, 248, 245, 0.94);
    backdrop-filter: blur(8px);
    color: var(--color-text-primary);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: background-color var(--transition-fast), color var(--transition-fast);
    z-index: 2;
  }

  .card-category-tag:hover {
    background-color: var(--color-text-primary);
    color: #ffffff;
  }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .meta-dot {
    font-size: 0.6rem;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.3;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .card-title a:hover {
    color: var(--color-accent-terracotta);
  }

  .card-description {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-light);
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.825rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent-terracotta);
    transition: gap var(--transition-fast);
  }

  .read-more-link:hover {
    gap: 0.65rem;
    color: var(--color-accent-terracotta-dark);
  }

  /* Featured Variation (e.g. for hero or prominent grid spot) */
  .post-card.featured {
    grid-column: span 2;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
  }

  .post-card.featured .card-media-wrapper {
    aspect-ratio: auto;
    height: 100%;
  }

  .post-card.featured .card-content {
    padding: 2.5rem;
    justify-content: center;
  }

  .post-card.featured .card-title {
    font-size: 1.85rem;
  }

  @media (max-width: 860px) {
    .post-card.featured {
      grid-column: span 1;
      display: flex;
      flex-direction: column;
    }
    .post-card.featured .card-media-wrapper {
      aspect-ratio: 2 / 3;
      height: auto;
    }
    .post-card.featured .card-content {
      padding: 1.5rem;
    }
  }
</style>
