---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Join The Aesthetic Edit",
  subtitle = "Receive our weekly Sunday morning digest of curated interior design inspiration, Pinterest-ready room boards, and exclusive Amazon decor finds."
} = Astro.props;
---

<section class="newsletter-section">
  <div class="newsletter-card">
    <div class="newsletter-decorative-circle"></div>
    <div class="newsletter-content">
      <span class="eyebrow">Weekly Editorial</span>
      <h3 class="newsletter-heading">{title}</h3>
      <p class="newsletter-sub">{subtitle}</p>

      <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Welcome to The Aesthetic Edit! Check your inbox shortly.');">
        <div class="input-wrap">
          <input 
            type="email" 
            placeholder="Enter your email address" 
            required 
            class="newsletter-input" 
            aria-label="Email address for newsletter"
          />
          <button type="submit" class="btn-primary subscribe-btn">
            <span>Subscribe</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
        <span class="privacy-note">No spam. Only intentional aesthetics. Unsubscribe anytime.</span>
      </form>
    </div>
  </div>
</section>

<style>
  .newsletter-section {
    padding: 3rem 0;
  }

  .newsletter-card {
    position: relative;
    background: linear-gradient(145deg, #FAF7F2 0%, #F1EAE0 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 4rem 2rem;
    text-align: center;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .newsletter-decorative-circle {
    position: absolute;
    top: -80px;
    right: -80px;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(185, 102, 70, 0.08) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
  }

  .newsletter-content {
    position: relative;
    max-width: 620px;
    margin: 0 auto;
    z-index: 1;
  }

  .newsletter-heading {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }

  .newsletter-sub {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .input-wrap {
    display: flex;
    width: 100%;
    max-width: 480px;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.35rem 0.35rem 1.25rem;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .input-wrap:focus-within {
    border-color: var(--color-accent-terracotta);
    box-shadow: 0 0 0 3px rgba(185, 102, 70, 0.15);
  }

  .newsletter-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 0.925rem;
    color: var(--color-text-primary);
    font-family: var(--font-sans);
  }

  .subscribe-btn {
    padding: 0.75rem 1.4rem;
    font-size: 0.85rem;
  }

  .privacy-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .newsletter-card {
      padding: 2.5rem 1.25rem;
    }
    .input-wrap {
      flex-direction: column;
      padding: 0.75rem;
      border-radius: var(--radius-md);
      gap: 0.75rem;
    }
    .newsletter-input {
      padding: 0.25rem;
    }
    .subscribe-btn {
      width: 100%;
      border-radius: var(--radius-full);
    }
  }
</style>
