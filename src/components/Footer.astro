---
const currentYear = new Date().getFullYear();

const categories = [
  { label: 'Coastal Farmhouse Living', href: '/categories/coastal-farmhouse' },
  { label: 'Luxury Bedroom Sanctuaries', href: '/categories/luxury-bedrooms' },
  { label: 'Wardrobe & Vanity Combos', href: '/categories/wardrobe-vanity' },
  { label: 'Modern Warm Kitchens', href: '/categories/modern-kitchens' },
];
---

<footer class="site-footer">
  <div class="container footer-content">
    
    <!-- Top Brand & Newsletter Grid -->
    <div class="footer-grid">
      
      <!-- Col 1: Brand Info -->
      <div class="footer-brand">
        <span class="footer-logo">AESTHETIC NEST</span>
        <p class="footer-tagline">
          Elevating everyday living through intentional interior design, warm organic minimalism, and curated aesthetic decor.
        </p>
        <div class="footer-socials">
          <a href="https://www.pinterest.com" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Pinterest">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.546.535 6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
            </svg>
            <span>Pinterest</span>
          </a>
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span>Instagram</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Categories -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Browse Spaces</h4>
        <ul class="footer-link-list">
          {categories.map((cat) => (
            <li>
              <a href={cat.href} class="footer-nav-link">{cat.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Editorial & Legal -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Editorial</h4>
        <ul class="footer-link-list">
          <li><a href="/disclosure" class="footer-nav-link">Affiliate Disclosure</a></li>
          <li><a href="/disclosure#privacy" class="footer-nav-link">Privacy Policy</a></li>
          <li><a href="/disclosure#terms" class="footer-nav-link">Terms of Service</a></li>
          <li><a href="/sitemap-index.xml" class="footer-nav-link">XML Sitemap</a></li>
        </ul>
      </div>

      <!-- Col 4: Quick Newsletter -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">The Weekly Edit</h4>
        <p class="newsletter-desc">Get the Sunday digest with handpicked decor, styling tips, and new moodboards directly to your inbox.</p>
        <form class="footer-newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing to The Weekly Edit!');">
          <input type="email" placeholder="Your email address" required class="footer-input" />
          <button type="submit" class="footer-submit-btn" aria-label="Subscribe to newsletter">Join</button>
        </form>
      </div>

    </div>

    <!-- FTC Affiliate Notice -->
    <div class="footer-ftc-notice">
      <p>
        <strong>FTC Affiliate Disclosure:</strong> Aesthetic Nest participates in the Amazon Services LLC Associates Program, an affiliate advertising program designed to provide a means for sites to earn advertising fees by advertising and linking to Amazon.com. Some links on this site are affiliate links, meaning we may earn a small commission if you make a purchase through them at no additional cost to you.
      </p>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p>© {currentYear} Aesthetic Nest. Curated with care for interior design enthusiasts.</p>
      <p class="credit">Pinterest-optimized layouts • Shoppable home decor</p>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: 4.5rem 0 2rem;
    margin-top: 5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1.2fr 1fr 1.4fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  .footer-logo {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-text-primary);
    display: block;
    margin-bottom: 1rem;
  }

  .footer-tagline {
    font-size: 0.925rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    max-width: 320px;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.825rem;
    color: var(--color-text-secondary);
    padding: 0.4rem 0.8rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .social-link:hover {
    color: var(--color-text-primary);
    border-color: var(--color-accent-sand);
    background-color: #ffffff;
  }

  .footer-col-title {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
  }

  .footer-link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-nav-link {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .footer-nav-link:hover {
    color: var(--color-accent-terracotta);
  }

  .newsletter-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .footer-newsletter-form {
    display: flex;
    gap: 0.5rem;
  }

  .footer-input {
    flex: 1;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .footer-input:focus {
    border-color: var(--color-accent-terracotta);
  }

  .footer-submit-btn {
    background-color: var(--color-text-primary);
    color: #FAF8F5;
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius-full);
    font-size: 0.825rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: all var(--transition-fast);
  }

  .footer-submit-btn:hover {
    background-color: var(--color-accent-terracotta);
  }

  .footer-ftc-notice {
    padding: 1.25rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    font-size: 0.775rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .footer-ftc-notice strong {
    color: var(--color-text-secondary);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border-light);
    padding-top: 1.75rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
