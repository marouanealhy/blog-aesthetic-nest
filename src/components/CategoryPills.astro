---
interface Props {
  activeCategory?: string;
  showAll?: boolean;
}

const { activeCategory = '', showAll = true } = Astro.props;

const categories = [
  { id: 'coastal-farmhouse', label: 'Coastal Farmhouse Living', href: '/categories/coastal-farmhouse' },
  { id: 'luxury-bedrooms', label: 'Luxury Bedrooms', href: '/categories/luxury-bedrooms' },
  { id: 'wardrobe-vanity', label: 'Wardrobe & Vanity Combos', href: '/categories/wardrobe-vanity' },
  { id: 'modern-kitchens', label: 'Modern Kitchens', href: '/categories/modern-kitchens' },
];
---

<div class="category-pills-nav" aria-label="Browse by Room Category">
  {showAll && (
    <a 
      href="/" 
      class={`category-pill ${activeCategory === '' ? 'active' : ''}`}
    >
      All Spaces
    </a>
  )}
  {categories.map((cat) => (
    <a 
      href={cat.href} 
      class={`category-pill ${activeCategory === cat.id ? 'active' : ''}`}
    >
      {cat.label}
    </a>
  ))}
</div>

<style>
  .category-pills-nav {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE */
  }

  .category-pills-nav::-webkit-scrollbar {
    display: none; /* Safari and Chrome */
  }

  .category-pill {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    padding: 0.5rem 1.15rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    background-color: var(--color-surface);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    transition: all var(--transition-fast);
  }

  .category-pill:hover {
    color: var(--color-text-primary);
    border-color: var(--color-accent-sand);
    background-color: var(--color-surface-subtle);
  }

  .category-pill.active {
    background-color: var(--color-text-primary);
    color: #FAF8F5;
    border-color: var(--color-text-primary);
    box-shadow: var(--shadow-sm);
  }
</style>
