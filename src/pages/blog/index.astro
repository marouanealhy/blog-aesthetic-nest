---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import CategoryPills from '../../components/CategoryPills.astro';
import Newsletter from '../../components/Newsletter.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = sortedPosts[0];
const remainingPosts = sortedPosts.slice(1);
---

<BaseLayout
  title="The Design Journal — All Articles & Room Guides | Aesthetic Nest"
  description="Explore our complete collection of curated interior design guides, modern bedroom ideas, warm minimalist kitchens, coastal living rooms, and shoppable decor edits."
  image={featuredPost?.data.heroImage}
>
  <!-- Blog Index Hero Banner -->
  <section class="blog-hero">
    <div class="container blog-hero-inner">
      <div class="blog-breadcrumbs">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="current">Journal & Articles</span>
      </div>

      <span class="eyebrow">The Editorial Archive</span>
      <h1 class="blog-page-title">The Design Journal</h1>
      <p class="blog-page-description">
        Step-by-step room styling breakdowns, tactile material palettes, shoppable Amazon decor, and effortless aesthetics for modern living.
      </p>

      <div class="category-filter-strip">
        <CategoryPills />
      </div>
    </div>
  </section>

  <!-- Featured Post Spotlight -->
  {featuredPost && (
    <section class="featured-spotlight-section">
      <div class="container">
        <div class="spotlight-badge-row">
          <span class="spotlight-tag">🌟 Latest Feature</span>
        </div>
        <div class="featured-hero-card">
          <div class="featured-hero-img-wrap">
            <a href={`/blog/${featuredPost.slug}`}>
              <img 
                src={featuredPost.data.heroImage} 
                alt={featuredPost.data.heroAlt}
                class="featured-hero-img"
                loading="eager"
              />
            </a>
            <span class="category-chip">{featuredPost.data.categoryLabel}</span>
          </div>

          <div class="featured-hero-content">
            <div class="post-meta-row">
              <span class="read-time">{featuredPost.data.readTime}</span>
              <span class="bullet">•</span>
              <time datetime={featuredPost.data.pubDate.toISOString()}>
                {new Date(featuredPost.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
            </div>

            <h2 class="featured-hero-title">
              <a href={`/blog/${featuredPost.slug}`}>
                {featuredPost.data.title}
              </a>
            </h2>

            <p class="featured-hero-excerpt">
              {featuredPost.data.description}
            </p>

            <div class="featured-hero-footer">
              <a href={`/blog/${featuredPost.slug}`} class="read-more-btn">
                <span>Read Guide</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- All Articles Grid Section -->
  <section class="all-posts-section section-spacing">
    <div class="container">
      <div class="posts-count-bar">
        <span class="posts-count">All Articles ({sortedPosts.length})</span>
        <span class="pinterest-hint">💡 All post imagery is formatted 1000×1500 for Pinterest saving</span>
      </div>

      <div class="articles-grid">
        {sortedPosts.map((post) => (
          <PostCard 
            slug={post.slug}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            categoryLabel={post.data.categoryLabel}
            heroImage={post.data.heroImage}
            heroAlt={post.data.heroAlt}
            readTime={post.data.readTime}
            featured={post.data.featured}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter Component -->
  <Newsletter />
</BaseLayout>

<style>
  .blog-hero {
    background: linear-gradient(180deg, var(--color-surface-subtle) 0%, var(--color-bg) 100%);
    border-bottom: 1px solid var(--color-border);
    padding: 3rem 0 3.5rem;
    text-align: center;
  }

  .blog-hero-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .blog-breadcrumbs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .blog-breadcrumbs a {
    color: var(--color-text-secondary);
  }

  .blog-breadcrumbs a:hover {
    color: var(--color-accent-terracotta);
  }

  .blog-breadcrumbs .sep {
    opacity: 0.4;
  }

  .blog-breadcrumbs .current {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
    color: var(--color-accent-terracotta);
    margin-bottom: 0.75rem;
  }

  .blog-page-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 600;
    line-height: 1.15;
    margin-bottom: 1rem;
    color: var(--color-text-primary);
  }

  .blog-page-description {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .category-filter-strip {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  /* Featured Spotlight Section */
  .featured-spotlight-section {
    padding: 3rem 0 1rem;
  }

  .spotlight-badge-row {
    margin-bottom: 1rem;
  }

  .spotlight-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--color-surface-subtle);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
  }

  .featured-hero-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  .featured-hero-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .featured-hero-img-wrap {
    position: relative;
    height: 100%;
    min-height: 340px;
    background: var(--color-surface-subtle);
    overflow: hidden;
  }

  .featured-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .featured-hero-card:hover .featured-hero-img {
    transform: scale(1.03);
  }

  .category-chip {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    color: var(--color-text-primary);
    box-shadow: var(--shadow-sm);
  }

  .featured-hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2.5rem 2.5rem 2.5rem 0;
  }

  .post-meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .bullet {
    opacity: 0.4;
  }

  .featured-hero-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 600;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .featured-hero-title a {
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .featured-hero-title a:hover {
    color: var(--color-accent-terracotta);
  }

  .featured-hero-excerpt {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .read-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-text-primary);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    transition: background var(--transition-fast), transform var(--transition-fast);
    align-self: flex-start;
  }

  .read-more-btn:hover {
    background: var(--color-accent-terracotta);
    color: #fff;
    transform: translateX(4px);
  }

  /* Grid Layout */
  .all-posts-section {
    padding: 3rem 0 5rem;
  }

  .posts-count-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.25rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .posts-count {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text-primary);
    font-family: var(--font-serif);
  }

  .pinterest-hint {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    background: var(--color-surface-subtle);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-light);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2.5rem 2rem;
  }

  @media (max-width: 860px) {
    .featured-hero-card {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .featured-hero-content {
      padding: 0 1.5rem 2rem;
    }

    .featured-hero-img-wrap {
      min-height: 260px;
    }
  }

  @media (max-width: 640px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }

    .blog-hero {
      padding: 2rem 0 2.5rem;
    }
  }
</style>
